# WIC kickstart file for Fontis Device x86-64 UEFI
# Partition layout:
#   p1: EFI System Partition (bootloader, kernels, initramfs)
#   p2: LUKS encrypted container (ext4 root filesystem)
#   p3: dm-verity hash tree data for root partition integrity

part /boot --source bootimg-efi --sourceparams="loader=systemd-boot" --ondisk sda --label EFI --active --align 1024 --size 500

part --source rawcopy --sourceparams="file=<rootfs>.luks" --ondisk sda --label cryptroot --align 1024 --size 2048

part --source rawcopy --sourceparams="file=<rootfs>.verity" --ondisk sda --label verity --align 1024 --size 32

# Bootloader
bootloader --timeout=5 --append="console=ttyS0,115200 console=tty1 rootwait quiet"
