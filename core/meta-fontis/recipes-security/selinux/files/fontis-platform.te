# Fontis platform SELinux policy
# Each runtime service runs as an isolated domain
# This is a skeleton policy that will be expanded during implementation
# Uses raw SELinux module syntax (no m4 macros) for direct checkmodule input

module fontis_platform 1.0.0;

# Identity service domain
type identity_service_t, domain;

# Auth service domain
type auth_service_t, domain;

# Storage service domain
type storage_service_t, domain;

# Networking service domain
type networking_service_t, domain;

# Socket directories for inter-service communication
type fontis_socket_t, file_type;
